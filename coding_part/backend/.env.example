# Local SQLite works without a database server.
DATABASE_URL=sqlite:///workforce.db

# For MySQL, create the database/user first and replace the URL above:
# DATABASE_URL=mysql+mysqlconnector://USER:PASSWORD@127.0.0.1:3306/workforce_analytics

# Optional directory produced by `python -m app.train_nlp`.
SKILL_NER_MODEL=
SKILL_NER_THRESHOLD=0.55
MAX_CANDIDATES=3000
CORS_ORIGINS=http://localhost:5173
