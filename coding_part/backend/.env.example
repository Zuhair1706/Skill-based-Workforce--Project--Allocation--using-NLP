# For MySQL, create this database/user first or point this URL at your instance.
DATABASE_URL=mysql+mysqlconnector://root:password@127.0.0.1:3306/workforce_analytics

# Optional directory produced by `python -m app.train_nlp`.
SKILL_NER_MODEL=
SKILL_NER_THRESHOLD=0.55
MAX_CANDIDATES=3000
CORS_ORIGINS=http://localhost:5173
